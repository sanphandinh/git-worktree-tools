{
  "name": "@sanphandinh/wtre",
  "version": "0.1.4",
  "type": "module",
  "description": "Simple but powerful CLI for managing git worktrees with AI agent collaboration support",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wt": "bin/wt.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "prepublishOnly": "bun run build && bun test"
  },
  "keywords": [
    "git",
    "worktree",
    "cli",
    "developer-tools",
    "productivity",
    "ai-agent",
    "parallel-development"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanphandinh/git-worktree-tools.git"
  },
  "bugs": {
    "url": "https://github.com/sanphandinh/git-worktree-tools/issues"
  },
  "homepage": "https://github.com/sanphandinh/git-worktree-tools#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "cosmiconfig": "^9.0.0",
    "execa": "^8.0.0",
    "ora": "^8.0.0",
    "tar-stream": "^3.1.7",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "^12.0.0",
    "@types/bun": "^1.3.8",
    "@types/node": "^20.0.0",
    "@types/tar-stream": "^3.1.4",
    "typescript": "^5.3.0"
  }
}
