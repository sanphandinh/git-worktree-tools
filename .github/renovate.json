{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "config:js-app",
    "group:allNonMajor",
    ":dependencyDashboard"
  ],
  "timezone": "UTC",
  "schedule": [
    "before 4am on saturday"
  ],
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 4am on sunday"
    ]
  },
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "rangeStrategy": "bump"
}
